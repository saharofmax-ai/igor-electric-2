---
// Импорт глобальных стилей
import '../styles/global.css';

// Импорт компонентов Header и Footer
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingContact from '../components/FloatingContact.astro';

// Props для передачи заголовка страницы и описания
interface Props {
  title?: string;
  description?: string;
}

const { 
  title = 'Электрик Игорь — электромонтаж в Москве и ближнем Подмосковье',
  description = 'Профессиональный электромонтаж в Москве и ближнем Подмосковье. 25 лет опыта. Гарантия качества. Выезд в день обращения. Аварийный вызов 24/7.'
} = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    
    <!-- Подключение шрифта Inter из Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    
    <!-- Фавикон — логотип сайта -->
    <link rel="icon" type="image/png" href="/images/logo.png" />
    
    <title>{title}</title>
  </head>
  <body>
    <!-- Шапка сайта -->
    <Header />

    <!-- Основной контент страницы -->
    <main>
      <slot />
    </main>

    <!-- Подвал сайта -->
    <Footer />

    <!-- Плавающая кнопка связи -->
    <FloatingContact />
  </body>
</html>