---
// Импорт глобальных стилей
import '../styles/global.css';

// Импорт компонентов Header и Footer
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingContact from '../components/FloatingContact.astro';

// Props для передачи заголовка страницы и описания
interface Props {
  title?: string;
  description?: string;
}

const { 
  title = 'Электрик в Михнево и Ступино | Проводка, щиты, аудит проекта | 4 группа допуска',
  description = 'Профессиональный электромонтаж в Михнево и Ступинском районе. Работаю в частном секторе, СНТ и на дачах. 25 лет опыта. Гарантия качества. Выезд в день обращения. Аварийный вызов 24/7.'
} = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    
    <!-- Подключение шрифта Inter из Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    
    <!-- Фавикон — логотип сайта -->
    <link rel="icon" type="image/png" href="/images/logo.png" />
    
    <title>{title}</title>

    <!-- Глобальное компактное масштабирование -->
    <style is:global>
      html {
        font-size: 85%;
      }
    </style>

    <!-- Микроразметка Schema.org для локального бизнеса -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Electrician",
      "name": "Электрик Игорь — Михнево и Ступинский район",
      "url": "https://electric-mihnevo-msk.netlify.app/",
      "telephone": "+79995567891",
      "priceRange": "от 500 ₽",
      "description": "Профессиональный электрик с 4 группой допуска. Электромонтаж, замена проводки, сборка щитов, аудит электропроектов. Выезд по Михнево, Ступино и Ступинскому району.",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Михнево",
        "addressRegion": "Московская область",
        "addressCountry": "RU"
      },
      "areaServed": [
        { "@type": "City", "name": "Михнево" },
        { "@type": "City", "name": "Ступино" },
        { "@type": "AdministrativeArea", "name": "Ступинский район" }
      ],
      "openingHoursSpecification": {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
        "opens": "09:00",
        "closes": "20:00"
      }
    })} />
  </head>
  <body>
    <!-- Шапка сайта -->
    <Header />

    <!-- Основной контент страницы -->
    <main>
      <slot />
    </main>

    <!-- Подвал сайта -->
    <Footer />

    <!-- Плавающая кнопка связи -->
    <FloatingContact />
  </body>
</html>