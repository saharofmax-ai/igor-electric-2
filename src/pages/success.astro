---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Заявка отправлена — Электрик Игорь">
  <section class="py-24 bg-gray-50 min-h-screen flex items-center">
    <div class="max-w-2xl mx-auto px-4 text-center">
      
      <!-- Иконка успеха -->
      <div class="mb-8">
        <div class="inline-flex items-center justify-center w-24 h-24 bg-green-100 rounded-full">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
            <polyline points="22 4 12 14.01 9 11.01"/>
          </svg>
        </div>
      </div>

      <!-- Заголовок -->
      <h1 class="text-3xl md:text-4xl font-extrabold text-gray-900 mb-4">
        Спасибо за заявку!
      </h1>

      <!-- Текст -->
      <p class="text-lg text-gray-600 mb-8 leading-relaxed">
        Ваша заявка успешно отправлена. Я перезвоню вам в течение 15 минут и отвечу на все вопросы.
      </p>

      <!-- Кнопки действия -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a 
          href="/" 
          class="bg-blue-700 text-white px-7 py-3 rounded-lg text-base font-semibold hover:bg-blue-800 active:bg-blue-900 active:scale-95 transition-all duration-150 shadow-lg"
        >
          Вернуться на главную
        </a>
        <a 
          href="tel:+79032213195" 
          class="bg-white text-blue-700 border-2 border-blue-700 px-7 py-3 rounded-lg text-base font-semibold hover:bg-blue-50 active:bg-blue-100 active:scale-95 transition-all duration-150"
        >
          Позвонить сейчас
        </a>
      </div>

    </div>
  </section>
</BaseLayout>