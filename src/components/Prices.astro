---
// Импортируем данные о ценах
import { prices } from '../data/prices.js';
---

<section id="prices" class="py-16 md:py-24 bg-gray-50">
  <div class="max-w-6xl mx-auto px-4">
    
    <!-- Заголовок секции -->
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-extrabold text-gray-900 mb-4">
        Цены на услуги
      </h2>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        Прозрачное ценообразование без скрытых доплат. Точная стоимость рассчитывается после осмотра объекта.
      </p>
    </div>

    <!-- Сетка категорий цен -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {prices.map((category) => (
        <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
          <h3 class="text-xl font-bold text-gray-900 mb-4 pb-3 border-b border-gray-200">
            {category.category}
          </h3>
          <ul class="space-y-4">
            {category.items.map((item) => (
              <li class="border-b border-gray-100 pb-3 last:border-0 last:pb-0">
                <div class="text-gray-700 text-sm mb-1">{item.name}</div>
                <div class="text-blue-700 font-semibold text-base">{item.price}</div>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Примечание -->
    <div class="mt-8 text-center">
      <p class="text-gray-600 text-sm">
        ℹ️ Точная стоимость работ определяется после осмотра объекта. Выезд мастера для оценки — бесплатно.
      </p>
    </div>

  </div>
</section>