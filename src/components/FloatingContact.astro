---
// Настройки мессенджеров
// WhatsApp: номер телефона в формате 79991234567 (без + и скобок)
const whatsappNumber = '79032213195';
const whatsappMessage = 'Здравствуйте! Хочу оставить заявку на электромонтажные работы.';

// Telegram: username без @
const telegramUsername = 'Semigow';
---

<!-- Плавающая кнопка связи -->
<div class="fixed bottom-6 right-6 z-50 flex flex-col items-end gap-3">
  
  <!-- Кнопки мессенджеров (скрыты по умолчанию) -->
  <div id="messenger-buttons" class="flex flex-col gap-3 opacity-0 pointer-events-none translate-y-4 transition-all duration-300">
    
    <!-- WhatsApp -->
    <a 
      href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`}
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center gap-3 group"
      aria-label="Написать в WhatsApp"
    >
      <span class="bg-white text-gray-700 text-sm font-medium px-3 py-1.5 rounded-lg shadow-md opacity-0 group-hover:opacity-100 transition-opacity hidden md:block">
        WhatsApp
      </span>
      <div class="bg-green-500 hover:bg-green-600 active:bg-green-700 active:scale-90 w-12 h-12 rounded-full flex items-center justify-center shadow-lg transition-all duration-150">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="white">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
        </svg>
      </div>
    </a>

    <!-- Telegram -->
    <a 
      href={`https://t.me/${telegramUsername}`}
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center gap-3 group"
      aria-label="Написать в Telegram"
    >
      <span class="bg-white text-gray-700 text-sm font-medium px-3 py-1.5 rounded-lg shadow-md opacity-0 group-hover:opacity-100 transition-opacity hidden md:block">
        Telegram
      </span>
      <div class="bg-blue-500 hover:bg-blue-600 active:bg-blue-700 active:scale-90 w-12 h-12 rounded-full flex items-center justify-center shadow-lg transition-all duration-150">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="white">
          <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
        </svg>
      </div>
    </a>

  </div>

  <!-- Главная кнопка (всегда видна) -->
  <button 
    id="floating-btn"
    class="bg-blue-700 hover:bg-blue-800 active:bg-blue-900 active:scale-90 w-14 h-14 rounded-full flex items-center justify-center shadow-lg transition-all duration-150"
    aria-label="Связаться с нами"
  >
    <svg id="icon-chat" xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
    </svg>
    <svg id="icon-close" class="hidden" xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="18" y1="6" x2="6" y2="18"/>
      <line x1="6" y1="6" x2="18" y2="18"/>
    </svg>
  </button>

</div>

<!-- JavaScript для работы кнопки -->
<script>
  const floatingBtn = document.getElementById('floating-btn');
  const messengerButtons = document.getElementById('messenger-buttons');
  const iconChat = document.getElementById('icon-chat');
  const iconClose = document.getElementById('icon-close');
  let isOpen = false;

  floatingBtn.addEventListener('click', () => {
    isOpen = !isOpen;
    
    if (isOpen) {
      messengerButtons.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-4');
      messengerButtons.classList.add('opacity-100', 'translate-y-0');
      iconChat.classList.add('hidden');
      iconClose.classList.remove('hidden');
    } else {
      messengerButtons.classList.add('opacity-0', 'pointer-events-none', 'translate-y-4');
      messengerButtons.classList.remove('opacity-100', 'translate-y-0');
      iconChat.classList.remove('hidden');
      iconClose.classList.add('hidden');
    }
  });

  // Закрытие при клике вне кнопок
  document.addEventListener('click', (e) => {
    if (isOpen && !e.target.closest('#floating-btn') && !e.target.closest('#messenger-buttons')) {
      isOpen = false;
      messengerButtons.classList.add('opacity-0', 'pointer-events-none', 'translate-y-4');
      messengerButtons.classList.remove('opacity-100', 'translate-y-0');
      iconChat.classList.remove('hidden');
      iconClose.classList.add('hidden');
    }
  });
</script>