---
// Импортируем данные
import { site } from '../data/site.js';
import { contacts } from '../data/contacts.js';
---

<section class="bg-gradient-to-br from-blue-50 to-white py-16 md:py-24">
  <div class="max-w-6xl mx-auto px-4 text-center">
    
    <!-- Главный заголовок -->
    <h1 class="text-3xl md:text-5xl font-extrabold text-gray-900 mb-5 leading-snug">
      {site.slogan}
    </h1>
    
    <!-- Подзаголовок -->
    <p class="text-lg md:text-xl text-gray-600 mb-8 max-w-3xl mx-auto">
      {site.description}
    </p>
    
    <!-- Две кнопки действия -->
    <div class="flex flex-col sm:flex-row gap-4 justify-center mb-14">
      <a 
        href={contacts.phoneLink} 
        class="bg-blue-700 text-white px-7 py-3 rounded-lg text-base font-semibold hover:bg-blue-800 active:bg-blue-900 active:scale-95 transition-all duration-150 shadow-lg"
      >
         Позвонить сейчас
      </a>
      <a 
        href="#contacts" 
        class="bg-white text-blue-700 border-2 border-blue-700 px-7 py-3 rounded-lg text-base font-semibold hover:bg-blue-50 active:bg-blue-100 active:scale-95 transition-all duration-150"
      >
        Оставить заявку
      </a>
    </div>

    <!-- Блок с преимуществами (с тонкими SVG-иконками) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto">
      
      <!-- Карточка 1: Выезд -->
      <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
        <div class="flex justify-center mb-3">
          <svg xmlns="http://www.w3.org/2000/svg" width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#0B5ED7" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
          </svg>
        </div>
        <h3 class="font-bold text-gray-900 mb-2 text-lg">Выезд в день обращения</h3>
        <p class="text-sm text-gray-600 leading-relaxed">Приеду быстро, когда нужно срочно. Работаю без выходных и праздников.</p>
      </div>

      <!-- Карточка 2: Гарантия -->
      <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
        <div class="flex justify-center mb-3">
          <svg xmlns="http://www.w3.org/2000/svg" width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#0B5ED7" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            <path d="m9 12 2 2 4-4"/>
          </svg>
        </div>
        <h3 class="font-bold text-gray-900 mb-2 text-lg">Гарантия на работы</h3>
        <p class="text-sm text-gray-600 leading-relaxed">Даю официальную гарантию от 3-х лет на все виды выполненных работ.</p>
      </div>

      <!-- Карточка 3: Цены -->
      <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
        <div class="flex justify-center mb-3">
          <svg xmlns="http://www.w3.org/2000/svg" width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#0B5ED7" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="8" cy="8" r="6"/>
            <path d="M18.09 10.37A6 6 0 1 1 10.34 18"/>
            <path d="M7 6h1v4"/>
            <path d="m16.71 13.88.7.71-2.82 2.82"/>
          </svg>
        </div>
        <h3 class="font-bold text-gray-900 mb-2 text-lg">Честные цены</h3>
        <p class="text-sm text-gray-600 leading-relaxed">Без скрытых доплат и накруток. Смета фиксируется до начала работ.</p>
      </div>

    </div>

  </div>
</section>