---
// Импортируем данные об отзывах
import { reviews } from '../data/reviews.js';
---

<section id="reviews" class="py-16 md:py-24 bg-white">
  <div class="max-w-6xl mx-auto px-4">
    
    <!-- Заголовок секции -->
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-extrabold text-gray-900 mb-4">
        Отзывы клиентов
      </h2>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        Мне доверяют жители Михнево и Ступинского района. Вот что они говорят о моей работе.
      </p>
    </div>

    <!-- Сетка отзывов -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {reviews.map((review) => (
        <div class="bg-gray-50 p-6 rounded-lg border border-gray-100 flex flex-col">
          
          <!-- Звёзды рейтинга -->
          <div class="flex gap-1 mb-3">
            {Array.from({ length: review.rating }).map(() => (
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="#FFB703" stroke="#FFB703" stroke-width="1">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
              </svg>
            ))}
          </div>

          <!-- Текст отзыва -->
          <p class="text-gray-700 text-sm leading-relaxed mb-4 flex-1">
            "{review.text}"
          </p>

          <!-- Имя клиента и вид работ -->
          <div class="border-t border-gray-200 pt-3">
            <div class="font-bold text-gray-900 text-sm">{review.name}</div>
            <div class="text-xs text-gray-500 mt-1">{review.work} · {review.date}</div>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>