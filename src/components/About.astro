---
import { site } from '../data/site.js';
---

<!-- Секция 1: Обо мне -->
<section id="about" class="py-10 md:py-16 bg-white">
  <div class="max-w-6xl mx-auto px-4">
    
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 md:gap-8 items-center">
      
      <!-- Левая колонка: Фото мастера -->
      <div class="relative max-w-sm md:max-w-md mx-auto w-full">
        <div class="aspect-[3/4] rounded-2xl bg-gray-100 overflow-hidden shadow-lg border border-gray-200">
          <img 
            src="/images/about.jpg" 
            alt="Электрик Игорь Семёнов" 
            class="w-full h-full object-cover"
          />
        </div>
        
        <!-- Бейдж с опытом -->
        <div class="absolute -bottom-4 -right-4 bg-blue-700 text-white p-4 rounded-xl shadow-xl hidden md:block">
          <div class="text-3xl font-extrabold">25</div>
          <div class="text-xs font-medium opacity-90">лет опыта</div>
        </div>
      </div>

      <!-- Правая колонка: Текст -->
      <div>
        <h2 class="text-2xl md:text-3xl font-extrabold text-gray-900 mb-4">
          Обо мне
        </h2>
        <p class="text-sm md:text-base text-gray-700 mb-3 leading-relaxed">
          Меня зовут Игорь. Я профессиональный электрик, и моя главная цель — сделать вашу электросеть безопасной, надёжной и удобной. Я не просто "чиню розетки", я проектирую и монтирую системы, которые служат десятилетиями.
        </p>
        <p class="text-sm md:text-base text-gray-700 mb-5 leading-relaxed">
          Работаю без посредников, поэтому лично отвечаю за каждый метр проложенного кабеля и каждый установленный автомат. 
        </p>

        <!-- Список преимуществ -->
        <ul class="space-y-3">
          <li class="flex items-start gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0B5ED7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0 mt-0.5">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
              <polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
            <span class="text-sm md:text-base text-gray-700">Использую только качественные, сертифицированные материалы (ГОСТ).</span>
          </li>
          <li class="flex items-start gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0B5ED7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0 mt-0.5">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
              <polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
            <span class="text-sm md:text-base text-gray-700">Предоставляю гарантию на работы сроком от 3 лет до пожизненной.</span>
          </li>
          <li class="flex items-start gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0B5ED7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0 mt-0.5">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
              <polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
            <span class="text-sm md:text-base text-gray-700">Всегда убираю за собой строительный мусор после завершения монтажа.</span>
          </li>
          <li class="flex items-start gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0B5ED7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0 mt-0.5">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
              <polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
            <span class="text-sm md:text-base text-gray-700">Смета фиксируется до начала работ, без скрытых доплат.</span>
          </li>
        </ul>

      </div>
    </div>
  </div>
</section>

<!-- Секция 2: Аудит и проверка электропроекта -->
<section class="py-10 md:py-16 bg-blue-50 border-y border-blue-100">
  <div class="max-w-6xl mx-auto px-4">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
      
      <!-- Левая колонка: Текст -->
      <div>
        <div class="inline-flex items-center gap-2 bg-blue-100 text-blue-800 px-3 py-1 rounded-full text-sm font-semibold mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" x2="8" y1="13" y2="13"/><line x1="16" x2="8" y1="17" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
          Уникальная услуга
        </div>
        <h2 class="text-2xl md:text-3xl font-extrabold text-gray-900 mb-4">
          Проверю ваш электропроект до монтажа
        </h2>
        <p class="text-sm md:text-base text-gray-700 mb-4 leading-relaxed">
          Красивый 3D-проект от дизайнера — не гарантия, что электрика в доме будет работать. Часто при монтаже выясняется, что розеток в нужных местах нет, сечение кабеля не выдержит нагрузку, а щит физически не встаёт в нишу.
        </p>
        <p class="text-sm md:text-base text-gray-700 mb-6 leading-relaxed font-medium">
          Я работаю иначе. Перед монтажом я проверяю проект и честно говорю, что можно оставить, а что технически нерабочее и приведёт к переделкам.
        </p>

        <ul class="space-y-3 mb-6">
          <li class="flex items-start gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0B5ED7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0 mt-0.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span class="text-sm md:text-base text-gray-700">Проверка схемы щита (номиналы, УЗО, селективность)</span>
          </li>
          <li class="flex items-start gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0B5ED7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0 mt-0.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span class="text-sm md:text-base text-gray-700">Проверка сечений кабеля под реальные нагрузки</span>
          </li>
          <li class="flex items-start gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0B5ED7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0 mt-0.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span class="text-sm md:text-base text-gray-700">Оценка соответствия ПУЭ и требований энергоснабжающей организации</span>
          </li>
        </ul>

        <div class="bg-white p-4 rounded-lg border border-blue-100 shadow-sm">
          <p class="text-sm text-gray-600 mb-3">Стоимость аудита: <span class="font-bold text-gray-900">от 3 000 ₽</span> (зависит от площади и сложности)</p>
          <a href="#contacts" class="inline-flex items-center gap-2 bg-blue-700 text-white px-5 py-2.5 rounded-lg text-sm font-semibold hover:bg-blue-800 transition-colors">
            Заказать проверку проекта
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        </div>
      </div>

      <!-- Правая колонка: Визуал -->
      <div class="relative max-w-md mx-auto w-full">
        <div class="aspect-[4/3] rounded-2xl bg-white border border-gray-200 shadow-lg p-6 flex flex-col justify-center items-center text-center">
          <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#0B5ED7" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mb-4">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
            <polyline points="14 2 14 8 20 8"/>
            <line x1="16" x2="8" y1="13" y2="13"/>
            <line x1="16" x2="8" y1="17" y2="17"/>
            <polyline points="10 9 9 9 8 9"/>
          </svg>
          <h3 class="text-xl font-bold text-gray-900 mb-2">Экономия на переделках</h3>
          <p class="text-sm text-gray-600">
            Проверка проекта окупается отсутствием дорогостоящих переделок и испорченного ремонта. Работаю с тем, что есть, и предлагаю решения, а не просто критику.
          </p>
        </div>
        <!-- Декоративный элемент -->
        <div class="absolute -z-10 top-4 -right-4 w-full h-full bg-blue-100 rounded-2xl"></div>
      </div>

    </div>
  </div>
</section>

<!-- Секция 3: Квалификация и допуски -->
<section class="py-10 md:py-16 bg-gray-50">
  <div class="max-w-6xl mx-auto px-4">
    
    <div class="text-center mb-8">
      <h2 class="text-2xl md:text-3xl font-extrabold text-gray-900 mb-3">
        Квалификация и допуски
      </h2>
      <p class="text-sm md:text-base text-gray-600 max-w-2xl mx-auto">
        Все работы выполняются в строгом соответствии с нормами электробезопасности
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 md:gap-8 items-center">
      
      <!-- Левая колонка: Удостоверение -->
      <div class="bg-white p-4 md:p-6 rounded-2xl shadow-lg border border-gray-100 max-w-sm md:max-w-md mx-auto w-full">
        <div class="aspect-[4/3] rounded-lg overflow-hidden bg-gray-100">
          <img 
            src="/images/certificate.jpg" 
            alt="Удостоверение о квалификации IV группы электробезопасности" 
            class="w-full h-full object-contain"
          />
        </div>
      </div>

      <!-- Правая колонка: Описание (ОБНОВЛЁННАЯ) -->
      <div>
        <div class="space-y-4">
          
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 bg-blue-100 p-2.5 rounded-lg">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#0B5ED7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                <path d="m9 12 2 2 4-4"/>
              </svg>
            </div>
            <div>
              <h3 class="text-lg md:text-xl font-bold text-gray-900 mb-1">IV группа электробезопасности</h3>
              <p class="text-sm md:text-base text-gray-700 leading-relaxed">
                Допуск к работам в электроустановках напряжением до 1000В.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 bg-blue-100 p-2.5 rounded-lg">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#0B5ED7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="20" height="14" x="2" y="5" rx="2"/>
                <line x1="2" x2="22" y1="10" y2="10"/>
              </svg>
            </div>
            <div>
              <h3 class="text-lg md:text-xl font-bold text-gray-900 mb-1">Повышение квалификации</h3>
              <p class="text-sm md:text-base text-gray-700 leading-relaxed">
                Действующее удостоверение о повышении квалификации (рег. номер 24/3523ПК).
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 bg-blue-100 p-2.5 rounded-lg">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#0B5ED7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                <polyline points="14 2 14 8 20 8"/>
                <line x1="16" x2="8" y1="13" y2="13"/>
                <line x1="16" x2="8" y1="17" y2="17"/>
                <polyline points="10 9 9 9 8 9"/>
              </svg>
            </div>
            <div>
              <h3 class="text-lg md:text-xl font-bold text-gray-900 mb-1">Соблюдение норм ПУЭ</h3>
              <p class="text-sm md:text-base text-gray-700 leading-relaxed">
                Все работы выполняются в соответствии с Правилами устройства электроустановок и правилами техники безопасности.
              </p>
            </div>
          </div>

        </div>
      </div>

    </div>

  </div>
</section>