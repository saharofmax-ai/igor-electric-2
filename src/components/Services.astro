---
// Импортируем данные об услугах
import { services } from '../data/services.js';

// Мапа иконок для каждой услуги (тонкие SVG)
const iconMap = {
  cable: `<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#0B5ED7" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"/></svg>`,
  socket: `<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#0B5ED7" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"/><circle cx="9" cy="10" r="1"/><circle cx="15" cy="10" r="1"/><path d="M9 14h6"/></svg>`,
  light: `<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#0B5ED7" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M12 2v1"/><path d="M12 7a5 5 0 1 0 5 5c0-2-1-3.5-2-5s-2-3-3-5"/></svg>`,
  panel: `<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#0B5ED7" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>`,
  emergency: `<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#0B5ED7" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>`,
  inspection: `<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#0B5ED7" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>`
};

// Иконка стрелки для ссылок
const arrowIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-x-1 transition-transform"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>`;
---

<section id="services" class="py-16 md:py-24 bg-white">
  <div class="max-w-6xl mx-auto px-4">
    
    <!-- Заголовок секции -->
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-extrabold text-gray-900 mb-4">
        Услуги
      </h2>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        Выполняю полный спектр электромонтажных работ — от замены розетки до полной проводки в доме
      </p>
    </div>

    <!-- Сетка карточек услуг -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {services.map((service) => {
        const isAudit = service.icon === 'inspection';
        const isWiring = service.icon === 'cable';
        const isPanel = service.icon === 'panel';
        const isEmergency = service.icon === 'emergency';
        const isLight = service.icon === 'light';
        
        return (
          <div class={`p-6 rounded-xl border transition-all duration-300 flex flex-col h-full ${
            isAudit 
              ? 'bg-blue-50 border-blue-200 hover:shadow-lg hover:border-blue-300' 
              : 'bg-gray-50 border-gray-100 hover:shadow-md'
          }`}>
            
            {isAudit && (
              <span class="inline-block bg-blue-600 text-white text-xs font-bold px-3 py-1 rounded-full mb-4 w-fit">
                Уникальная услуга
              </span>
            )}

            <div class="mb-4" set:html={iconMap[service.icon] || iconMap.cable}></div>
            
            <h3 class={`text-xl font-bold mb-2 ${isAudit ? 'text-blue-900' : 'text-gray-900'}`}>
              {service.title}
            </h3>
            
            <p class="text-gray-600 text-sm leading-relaxed mb-6 flex-grow">
              {service.description}
            </p>
            
            {/* Блок ссылок внизу карточки */}
            <div class="mt-auto pt-4 border-t border-gray-100 flex flex-col gap-2">
              {isAudit ? (
                <a href="/audit" class="inline-flex items-center gap-2 text-blue-700 font-semibold hover:text-blue-800 text-sm group">
                  Узнать подробнее и заказать проверку
                  <span set:html={arrowIcon}></span>
                </a>
              ) : isWiring ? (
                <>
                  <a href="/wiring" class="inline-flex items-center gap-2 text-blue-700 font-semibold hover:text-blue-800 text-sm group">
                    Подробнее о замене проводки
                    <span set:html={arrowIcon}></span>
                  </a>
                  <a href="/cottage" class="inline-flex items-center gap-2 text-gray-600 font-medium hover:text-blue-700 text-sm group">
                    Электромонтаж в домах и СНТ
                    <span set:html={arrowIcon}></span>
                  </a>
                </>
              ) : isPanel ? (
                <a href="/panel" class="inline-flex items-center gap-2 text-blue-700 font-semibold hover:text-blue-800 text-sm group">
                  Подробнее о сборке щитов
                  <span set:html={arrowIcon}></span>
                </a>
              ) : isEmergency ? (
                <a href="/emergency" class="inline-flex items-center gap-2 text-red-700 font-semibold hover:text-red-800 text-sm group">
                  Вызвать электрика срочно
                  <span set:html={arrowIcon}></span>
                </a>
              ) : isLight ? (
                <a href="/lighting" class="inline-flex items-center gap-2 text-blue-700 font-semibold hover:text-blue-800 text-sm group">
                  Подробнее о монтаже освещения
                  <span set:html={arrowIcon}></span>
                </a>
              ) : (
                <a href="#contacts" class="inline-flex items-center gap-2 text-gray-500 font-medium hover:text-blue-700 text-sm group">
                  Заказать услугу
                  <span set:html={arrowIcon}></span>
                </a>
              )}
            </div>
            
          </div>
        );
      })}
    </div>

  </div>
</section>