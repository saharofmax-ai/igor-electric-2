---
import { portfolioCategories } from '../data/portfolio.js';
---

<section id="portfolio" class="py-16 md:py-24 bg-gray-50">
  <div class="max-w-6xl mx-auto px-4">
    
    <!-- Заголовок секции -->
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-extrabold text-gray-900 mb-4">
        Примеры моих работ
      </h2>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        Нажмите на категорию, чтобы посмотреть все фотографии из этой серии.
      </p>
    </div>

    <!-- Сетка категорий (6 карточек) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {portfolioCategories.map((category) => (
        <div 
          class="group bg-white rounded-lg shadow-sm border border-gray-100 overflow-hidden hover:shadow-lg transition-shadow duration-300 cursor-pointer"
          data-category={category.id}
          data-count={category.count}
          data-title={category.title}
        >
          <!-- Превью (первое фото из папки) -->
          <div class="overflow-hidden h-56 bg-gray-200 relative">
            <img 
              src={`/images/gallery/${category.id}/1.jpg`} 
              alt={category.title} 
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
              loading="lazy"
              width="800"
              height="600"
            />
            <!-- Иконка лупы при наведении -->
            <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"/>
                <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                <line x1="11" y1="8" x2="11" y2="14"/>
                <line x1="8" y1="11" x2="14" y2="11"/>
              </svg>
            </div>
          </div>

          <!-- Название категории -->
          <div class="p-5 text-center">
            <h3 class="text-lg font-bold text-gray-900">{category.title}</h3>
            <p class="text-sm text-gray-500 mt-1">{category.count} фото</p>
          </div>
        </div>
      ))}
    </div>

  </div>

  <!-- Модальное окно (Галерея) -->
  <div id="gallery-modal" class="fixed inset-0 z-[100] hidden bg-black/90 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="relative bg-white rounded-xl max-w-5xl w-full max-h-[90vh] flex flex-col overflow-hidden">
      
      <!-- Шапка модального окна -->
      <div class="flex justify-between items-center p-4 border-b border-gray-200">
        <h3 id="modal-title" class="text-xl font-bold text-gray-900"></h3>
        <button id="modal-close" class="p-2 hover:bg-gray-100 rounded-full transition-colors" aria-label="Закрыть">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>

      <!-- Контейнер для фото (с прокруткой) -->
      <div id="modal-images" class="flex-1 overflow-y-auto p-4 grid grid-cols-1 sm:grid-cols-2 gap-4">
        <!-- Сюда JavaScript вставит изображения -->
      </div>

    </div>
  </div>
</section>

<!-- JavaScript для работы галереи -->
<script is:inline>
  const cards = document.querySelectorAll('[data-category]');
  const modal = document.getElementById('gallery-modal');
  const modalTitle = document.getElementById('modal-title');
  const modalImages = document.getElementById('modal-images');
  const modalClose = document.getElementById('modal-close');

  // Открытие галереи
  cards.forEach(card => {
    card.addEventListener('click', () => {
      const category = card.getAttribute('data-category');
      const count = parseInt(card.getAttribute('data-count'));
      const title = card.getAttribute('data-title');

      modalTitle.textContent = title;
      modalImages.innerHTML = ''; // Очищаем старые фото

      // Генерируем теги img для каждого файла
      for (let i = 1; i <= count; i++) {
        const img = document.createElement('img');
        img.src = `/images/gallery/${category}/${i}.jpg`;
        img.alt = `${title} - фото ${i}`;
        img.className = 'w-full h-auto rounded-lg shadow-sm hover:shadow-md transition-shadow cursor-zoom-in';
        img.loading = 'lazy';
        modalImages.appendChild(img);
      }

      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden'; // Блокируем прокрутку основной страницы
    });
  });

  // Закрытие галереи
  const closeModal = () => {
    modal.classList.add('hidden');
    document.body.style.overflow = ''; // Возвращаем прокрутку
  };

  modalClose.addEventListener('click', closeModal);
  
  // Закрытие при клике на затемнённый фон
  modal.addEventListener('click', (e) => {
    if (e.target === modal) {
      closeModal();
    }
  });

  // Закрытие по клавише Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
      closeModal();
    }
  });
</script>