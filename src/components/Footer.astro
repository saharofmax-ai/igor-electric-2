---
// Импортируем данные
import { site } from '../data/site.js';
import { contacts } from '../data/contacts.js';
---

<footer class="bg-gray-900 text-gray-300 py-12">
  <div class="max-w-6xl mx-auto px-4 grid md:grid-cols-3 gap-8">

    <!-- Колонка 1: Логотип и описание -->
    <div>
      <a href="/" class="inline-block mb-4">
        <img src="/images/logo.png" alt={site.name} class="h-16 w-auto" />
      </a>
      <p class="text-sm">{site.description}</p>
    </div>

    <!-- Колонка 2: Контакты -->
    <div>
      <h3 class="text-white text-lg font-bold mb-4">Контакты</h3>
      <ul class="space-y-3 text-sm">
        <li>
          <a href={contacts.phoneLink} class="flex items-center gap-2 hover:text-white transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            {contacts.phone}
          </a>
        </li>
        <li>
          <a href={contacts.emailLink} class="flex items-center gap-2 hover:text-white transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="16" x="2" y="4" rx="2"/>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
            {contacts.email}
          </a>
        </li>
        <li class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          {contacts.address}
        </li>
      </ul>
    </div>

    <!-- Колонка 3: Режим работы -->
    <div>
      <h3 class="text-white text-lg font-bold mb-4">Режим работы</h3>
      <div class="flex items-center gap-2 text-sm mb-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <polyline points="12 6 12 12 16 14"/>
        </svg>
        {contacts.workHours}
      </div>
      <p class="text-yellow-400 font-medium text-sm ml-6">Аварийный вызов — 24/7</p>
    </div>

  </div>

  <!-- Нижняя полоса с копирайтом и политикой конфиденциальности -->
  <div class="border-t border-gray-700 mt-8 pt-6">
    <div class="max-w-6xl mx-auto px-4 flex flex-col md:flex-row justify-between items-center gap-3 text-sm text-gray-500">
      <p>© 2026 {site.name}. Все права защищены.</p>
      <a href="/privacy" class="hover:text-white transition-colors">Политика конфиденциальности</a>
    </div>
  </div>
</footer>